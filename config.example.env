# ops-kit config. Copy to /etc/ops-kit.env (or point OPS_KIT_CONFIG at it).
# KEY=VALUE lines only. Real environment variables (cron lines) override this file.

# --- notifier (notify.sh) ---
# Unset = alerts print to stdout (cron mail / log file).
# uptime-prober and dead-mans-switch REQUIRE a webhook.
#ALERT_WEBHOOK_URL=https://hooks.example.com/ops
#ALERT_WEBHOOK_TOKEN=change-me

# --- fleet ---
# "name=ssh-target" entries; "local" runs on this machine. Default: local.
# Example below is commented out: set your own hosts.
#HOSTS="local web1=web1.example.com db1=db1.example.com"
# lines: "name target"
#HOSTS_FILE=/etc/ops-kit/hosts.txt
SSH_USER=root
#SSH_OPTS="-o ConnectTimeout=15 -o BatchMode=yes -o StrictHostKeyChecking=accept-new"

# --- domains (cert-expiry, domain-expiry, uptime-prober) ---
#DOMAINS="app.example.com www.example.com"
# one per line
#DOMAINS_FILE=/etc/ops-kit/domains.txt
#EXCLUDE_FILE=/etc/ops-kit/uptime-exclude.txt
# empty string disables deep health
#HEALTH_PATH=/api/health

# --- state ---
#STATE_DIR=/var/lib/ops-kit
#RUN_DIR=/run/ops-kit

# --- thresholds ---
# mem-headroom: % of container --memory limit
#THRESHOLD=90
# disk-headroom: % used (blocks and inodes)
#PCT=85
# cert-expiry: warn below this many days
#WARN_DAYS=14
# domain-expiry: warn below this many days
#DOMAIN_WARN_DAYS=30
# cert-expiry error level
#CRIT_DAYS=3
# crash-loop: new restarts since last run
#RESTART_DELTA=3

# --- dead-mans-switch (run on a separate box) ---
#CORE_DOMAINS="status.example.com"
#CRITICAL_FILE=/etc/ops-kit/critical-domains.txt

# --- rogue-container-watch ---
#KNOWN_CONTAINERS="web api"
# "container" or "host-name:container"
#KNOWN_FILE=/etc/ops-kit/known-containers.txt

# --- restore-drill ---
# <app>/<dump>.sql[.gz|.enc]
#BACKUP_DIR=/var/backups/db
#PASSPHRASE_FILE=/etc/ops-kit/backup.pass

# --- cron-report ---
#HOST_ID=web1
#CRON_REPORT_SUCCESS=0
#CRON_MAX_SECONDS=3600
#CRON_HEARTBEAT_URL=https://hc.example.com/ping/your-uuid
